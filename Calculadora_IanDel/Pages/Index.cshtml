@page
@model Calculadora_IanDEl.Pages.IndexModel
@{
    ViewData["Title"] = "Calculadora IMC";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mt-4">
            <div class="card-header">
                <h4 class="mb-0">Calculadora de IMC</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label for="peso" class="form-label">Peso (kg)</label>
                        <input asp-for="Peso" class="form-control" id="peso" type="number" step="0.1" />
                    </div>
                    <div class="mb-3">
                        <label for="altura" class="form-label">Altura (m)</label>
                        <input asp-for="Altura" class="form-control" id="altura" type="number" step="0.01" />
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <button type="submit" class="btn btn-primary">Calcular</button>
                        </div>
                        <div class="text-end">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        </div>
                    </div>
                </form>

                @if (Model.Imc.HasValue)
                {
                    <hr />
                    <h5>Resultado</h5>
                    <p class="mb-1">IMC: <strong>@Model.Imc.Value.ToString("0.00")</strong></p>
                    <p>Categoría: <strong>@Model.Categoria</strong></p>
                }
            </div>
        </div>

        <!-- Tabla de cálculos de la sesión -->
        <div class="card mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Historial (sesión)</h5>
                <form method="post" asp-page-handler="Clear" onsubmit="return confirm('¿Borrar todos los cálculos de la sesión?');">
                    <button type="submit" class="btn btn-sm btn-danger">Borrar historial</button>
                </form>
            </div>
            <div class="card-body p-0">
                @if (Model.Calculations != null && Model.Calculations.Any())
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Peso (kg)</th>
                                    <th>Altura (m)</th>
                                    <th>IMC</th>
                                    <th>Categoría</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Calculations.OrderByDescending(c => c.Fecha))
                                {
                                    <tr>
                                        <td>@item.Fecha.ToString("g")</td>
                                        <td>@item.Peso.ToString("0.00")</td>
                                        <td>@item.Altura.ToString("0.00")</td>
                                        <td>@item.Imc.ToString("0.00")</td>
                                        <td>@item.Categoria</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-3">No hay cálculos realizados en esta sesión.</div>
                }
            </div>
        </div>
    </div>
</div>

